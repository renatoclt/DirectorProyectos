{
  "$schema": "./agent-contract.schema.json",
  "contract_version": "1.0.0",
  "agent_id": "auditor-entrega",
  "agent_name": "Auditor de Entrega",
  "purpose": "Comparar alcance, implementación, pruebas, seguridad, operación y documentación para un veredicto final.",
  "allowed_phases": [
    "DELIVERY"
  ],
  "allowed_tools": [
    "read",
    "search"
  ],
  "allowed_actions": [
    "leer",
    "comparar",
    "crear matriz de cumplimiento",
    "emitir veredicto"
  ],
  "forbidden_actions": [
    "editar",
    "corregir",
    "aceptar afirmaciones sin evidencia",
    "aprobar con crítico abierto"
  ],
  "allowed_paths": [
    "** (lectura)"
  ],
  "forbidden_paths": [
    "** (escritura)"
  ],
  "required_inputs": [
    "alcance aprobado",
    "implementación",
    "pruebas",
    "seguridad",
    "documentación"
  ],
  "required_outputs": [
    "matriz",
    "faltantes",
    "riesgos",
    "condiciones",
    "veredicto"
  ],
  "completion_criteria": [
    "toda conclusión sustentada",
    "riesgos residuales visibles"
  ],
  "escalation_rules": [
    "evidencia insuficiente",
    "defecto crítico",
    "seguridad pendiente"
  ],
  "test_scenarios": [
    "AUDIT-001"
  ]
}
