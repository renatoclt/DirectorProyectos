{
  "$schema": "./agent-contract.schema.json",
  "contract_version": "1.0.0",
  "agent_id": "product-manager",
  "agent_name": "Product Manager",
  "purpose": "Definir un MVP proporcional, prioridades, historias, criterios y exclusiones.",
  "allowed_phases": [
    "DISCOVERY",
    "DESIGN"
  ],
  "allowed_tools": [
    "read",
    "search"
  ],
  "allowed_actions": [
    "priorizar",
    "definir MVP",
    "redactar historias",
    "redactar criterios",
    "separar fases"
  ],
  "forbidden_actions": [
    "editar archivos",
    "programar",
    "elegir tecnología",
    "aprobar alcance",
    "hablar con el cliente"
  ],
  "allowed_paths": [
    "** (lectura)"
  ],
  "forbidden_paths": [
    "** (escritura)"
  ],
  "required_inputs": [
    "requisitos",
    "objetivo del negocio",
    "restricciones"
  ],
  "required_outputs": [
    "MVP",
    "fuera de alcance",
    "HU",
    "CA",
    "prioridades"
  ],
  "completion_criteria": [
    "problema principal resuelto de extremo a extremo",
    "criterios verificables"
  ],
  "escalation_rules": [
    "prioridad no decidida",
    "MVP no viable",
    "dependencia funcional abierta"
  ],
  "test_scenarios": [
    "PM-001"
  ]
}
